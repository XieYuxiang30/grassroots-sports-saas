# ============================================================================
# 基层赛事 SaaS 平台 — 环境变量模板
# 复制为 .env 后按需修改：
#   - 只想快速跑起来（零基础设施）：保持 STORAGE_DRIVER=json 即可，无需 PostgreSQL
#   - 生产 / 完整链路：STORAGE_DRIVER=prisma 并填好 DATABASE_URL
# ============================================================================

# ---------- 服务端 ----------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 允许跨域的前端源，逗号分隔；* 表示全部允许（仅建议开发环境）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:19387

# 计分员登录口令（Admin / Scorer 端），生产环境请务必修改
SCORER_PASSCODE=hoop2024

# ---------- 数据存储 ----------
# json   = 零依赖文件存储，开箱即用（默认，用于本地开发与演示）
# prisma = PostgreSQL + Prisma ORM（生产推荐）
STORAGE_DRIVER=json

# json 驱动的数据目录（相对仓库根目录或绝对路径）
DATA_DIR=./data

# prisma 驱动需要的连接串（docker compose up -d 可直接拉起）
DATABASE_URL=postgresql://hoop:hoop_dev_pw@localhost:5432/openhoopscore?schema=public

# ---------- 实时通信 ----------
# Socket.IO 心跳与超时（毫秒）；弱网环境可适当放宽
SOCKET_PING_INTERVAL=20000
SOCKET_PING_TIMEOUT=25000

# 单场比赛事件数上限（防止异常客户端刷爆存储）
MAX_EVENTS_PER_MATCH=20000

# 离线客户端补传时单批最大事件数
MAX_SYNC_BATCH=500

# ---------- 前端（apps/web）----------
# 前端访问后端 API 的地址；留空则走同源（生产由 api 直接托管前端产物）
VITE_API_BASE_URL=http://localhost:3000
VITE_SOCKET_PATH=/socket.io
