{
  "name": "openhoopscore",
  "version": "1.0.0",
  "private": true,
  "description": "基层赛事 SaaS 平台 — 计分记录 → 实时展示 闭环，离线优先 + 事件溯源",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-modules.mjs",
    "fix:modules": "node scripts/fix-node-modules.mjs",
    "build": "node scripts/build-all.mjs",
    "build:contracts": "node scripts/build-all.mjs contracts",
    "dev": "node scripts/build-all.mjs contracts && pnpm -r --parallel --filter ./apps/api --filter ./apps/web dev",
    "dev:api": "node scripts/build-all.mjs contracts && pnpm --filter @openhoopscore/api dev",
    "dev:web": "pnpm --filter @openhoopscore/web dev",
    "dev:mini": "pnpm --filter @openhoopscore/miniprogram dev:weapp",
    "start": "pnpm --filter @openhoopscore/api start",
    "test": "node scripts/build-all.mjs contracts && pnpm -r test",
    "test:api": "pnpm --filter @openhoopscore/api test",
    "test:e2e": "pnpm --filter @openhoopscore/api test:e2e",
    "test:web-offline": "pnpm --filter @openhoopscore/web verify:offline",
    "typecheck": "pnpm -r typecheck",
    "clean": "node scripts/build-all.mjs clean",
    "db:generate": "pnpm --filter @openhoopscore/api db:generate",
    "db:migrate": "pnpm --filter @openhoopscore/api db:migrate",
    "db:deploy": "pnpm --filter @openhoopscore/api db:deploy",
    "db:seed": "pnpm --filter @openhoopscore/api db:seed"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
