# 国内网络环境使用镜像源；如需官方源，改成 https://registry.npmjs.org/
registry=https://registry.npmmirror.com/

# ---------------------------------------------------------------------------
# 为什么要这些 pnpm 布局设置（踩过的坑，别删）
# ---------------------------------------------------------------------------
# pnpm 默认使用「符号链接 + 虚拟 store」布局。Windows 上创建**文件符号链接**
# 需要开启「开发者模式」或持有 SeCreateSymbolicLinkPrivilege，普通账户/受限环境
# 会直接 EPERM 失败。失败后的表现极具迷惑性：安装日志一路绿色 "Done"，
# 但 node_modules 里只有一层直接依赖，嵌套依赖（tslib / uid / make-error ...）
# 全部解析不到，运行时报一堆 MODULE_NOT_FOUND。
#
# 因此这里显式声明布局与提升策略，保证在**没有符号链接权限**的机器上也能装好：
#   node-linker=hoisted      → 不用符号链接，用真实目录
#   public-hoist-pattern=*   → 所有嵌套依赖都提升到 app 的 node_modules 顶层
# 代价只是磁盘占用变大，换来的是「装上就能跑」。
node-linker=hoisted
public-hoist-pattern[]=*
shamefully-hoist=true

# 依赖解析与锁文件行为
resolution-mode=highest
strict-peer-dependencies=false
auto-install-peers=true
